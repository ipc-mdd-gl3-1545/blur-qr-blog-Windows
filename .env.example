# ===================================================================
#  模糊二维码 · 博客后端 配置示例
#  用法：cp .env.example .env  然后按需修改（改完重启服务生效）
#  注意：本文件不含任何密码，可以安全提交到 Git
# ===================================================================

# ---------- 服务监听 ----------
# Nginx 反向代理时建议绑定 127.0.0.1（只有本机能连，外网只能经由 Nginx）
# 不使用 Nginx、直接对外暴露端口时改成 0.0.0.0
HOST=127.0.0.1
PORT=8080

# 位于 Nginx / CDN 之后请设为 1，这样才能取到真实访客 IP 并识别 HTTPS
TRUST_PROXY=1

# ---------- 管理后台 ----------
# 后台访问路径（不会在首页出现任何入口，只有知道这个地址才能打开登录页）
# 建议改成一串别人猜不到的字符，例如 /manage-x7k2p9
ADMIN_PATH=/manage

# 后台密码哈希。生成方式：
#   node tools/hash-password.js '你的密码'
# 把输出的整行（scrypt$...）粘贴到等号后面
ADMIN_PASSWORD_HASH=

# 登录会话有效期（小时）
SESSION_TTL_HOURS=12

# 登录失败限速：10 分钟内最多尝试次数，超限锁定 15 分钟
LOGIN_MAX_TRIES=8

# 撤销所有已登录会话用的签名密钥。留空则自动生成并保存在 data/session.key
SESSION_SECRET=

# ---------- 存储路径 ----------
# 相对路径以项目根目录为基准，也可以写绝对路径（如 /var/lib/blog/data）
DATA_DIR=./data
UPLOAD_DIR=./uploads

# 单张图片最大体积（MB）
MAX_IMAGE_MB=5

# ---------- 其他 ----------
# 是否对 HTML / CSS / JS / JSON 开启 gzip 压缩
GZIP=1

# 是否记录每一条 HTTP 请求（关掉之后只记登录、发布、上传、报错这些事件）
LOG_REQUESTS=1

# 后台「日志」页能在内存里翻多少条（超出后最旧的被挤掉，不影响磁盘文件）
LOG_BUFFER=1200

# 日志文件大小上限（MB），超过就轮转成 blog.log.1，只保留一份旧的
LOG_FILE_MB=5

# 后台「监控」页的采样间隔（秒）与保留点数
# 180 × 10 秒 = 30 分钟的趋势图
METRIC_INTERVAL_SEC=10
METRIC_HISTORY=180

# ---------- 小影院：本地视频 ----------
# 视频目录。留空则用项目下的 ./videos（首次启动自动创建），一般不用改
# 想放别处就写绝对路径：Windows 例 D:/blog-videos，Linux 例 /opt/blog/videos
# 支持的扩展名：mp4 m4v webm mkv mov avi flv f4v ts m3u8
# 浏览器能直接播的只有 mp4(H.264)/webm，其它格式建议先转码
LOCAL_VIDEO_DIR=

# 后台单个视频文件上限（MB）。后台直接写盘、不占内存，只受磁盘空间限制
MAX_VIDEO_MB=4096

# ---------- 弹幕 ----------
# 单条弹幕最大字数
DANMAKU_MAX_LEN=50

# 同一 IP 两次发送的最小间隔（秒）
DANMAKU_COOLDOWN_SEC=3

# 每次进入视频最多拉取多少条历史弹幕
DANMAKU_FETCH_MAX=2000
