# 统一换行符：避免 Windows 上编辑后脚本带着 CRLF 传到 Linux 直接报错
* text=auto

# 部署脚本 / 服务配置必须是 LF
*.sh      text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
.env.example text eol=lf

# 二进制资源不做任何转换
*.mp4  binary
*.jpg  binary
*.png  binary
*.gif  binary
*.webp binary
*.iso  binary
*.gz   binary
